<div class="wrap"><nav id="nav"></nav><main id="main"></main></div>
<script id="data" type="application/json">__DATA__</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/12.0.2/marked.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>
<script>
const items = JSON.parse(document.getElementById('data').textContent);
const md = (s) => (window.marked && window.DOMPurify)
  ? DOMPurify.sanitize(marked.parse(s, {breaks: true}))
  : null;
const esc = (s) => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt = (t) => { if (!t) return ''; const d = new Date(t);
  return d.toLocaleDateString(undefined,{month:'short',day:'numeric'})+' '+d.toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'}); };
const main = document.getElementById('main'), nav = document.getElementById('nav');
let n = 0;
for (const it of items) {
  let el;
  if (it.k === 'user' || it.k === 'claude') {
    el = document.createElement('div');
    el.className = 'm ' + it.k; el.id = 'm' + (n++);
    const html = it.k === 'claude' ? md(it.text) : null;
    el.innerHTML = `<div class="who"><b>${it.k === 'user' ? 'You' + (it.mid ? ' (sent mid-turn)' : '') : 'Claude'}</b><span>${fmt(it.t)}</span></div>`
      + (html ? `<div class="body">${html}</div>` : `<div class="body plain">${esc(it.text)}</div>`);
    if (it.k === 'user') {
      const a = document.createElement('a'); a.href = '#' + el.id;
      a.innerHTML = esc(it.text.split('\n')[0].slice(0, 90)) + `<small>${fmt(it.t)}</small>`;
      nav.appendChild(a);
    }
  } else if (it.k === 'tools') {
    el = document.createElement('div'); el.className = 'tools tool-step';
    const uniq = [...new Set(it.names)];
    el.textContent = `⋯ ${it.names.length} tool step${it.names.length>1?'s':''}: ${uniq.slice(0,6).join(', ')}${uniq.length>6?', …':''}`;
  } else if (it.k === 'command') {
    el = document.createElement('div'); el.className = 'cmd';
    el.innerHTML = `You ran <code>${esc(it.text)}</code> · ${fmt(it.t)}`;
  } else if (it.k === 'compact') {
    el = document.createElement('details'); el.className = 'compact'; el.id = 'm' + (n++);
    const h = it.summary ? (md(it.summary) || `<div class="plain">${esc(it.summary)}</div>`) : '<i>No summary saved.</i>';
    el.innerHTML = `<summary>Conversation compacted here · ${fmt(it.t)} — everything above is what the live session lost. Click for the summary Claude kept.</summary><div class="body">${h}</div>`;
    const c = document.createElement('div'); c.className = 'c'; c.textContent = '— compacted ' + fmt(it.t) + ' —'; nav.appendChild(c);
  }
  if (el) { el.dataset.k = it.k; el.dataset.raw = (it.text || it.summary || '').toLowerCase(); main.appendChild(el); }
}
const q = document.getElementById('q'), mine = document.getElementById('mine'), tools = document.getElementById('tools'), count = document.getElementById('count');
function unmark(el){ el.querySelectorAll('mark').forEach(m => m.replaceWith(m.textContent)); el.normalize(); }
function markIn(el, term){
  const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT); const hits = []; let t;
  while ((t = w.nextNode())) { if (t.parentNode.closest('.who')) continue; const i = t.nodeValue.toLowerCase().indexOf(term); if (i >= 0) hits.push([t, i]); }
  for (const [t, i] of hits) { const r = document.createRange(); r.setStart(t, i); r.setEnd(t, i + term.length); const m = document.createElement('mark'); r.surroundContents(m); }
}
function apply(){
  const term = q.value.trim().toLowerCase(); let shown = 0;
  for (const el of main.children) {
    unmark(el);
    let ok = true;
    if (el.dataset.k === 'tools') ok = tools.checked && !term && !mine.checked;
    else if (el.dataset.k === 'command') ok = !term;
    else if (mine.checked && el.dataset.k !== 'user') ok = false;
    if (ok && term) ok = el.dataset.raw.includes(term);
    el.classList.toggle('hide', !ok);
    if (ok && term) { if (el.tagName === 'DETAILS') el.open = true; markIn(el, term); }
    if (ok && el.dataset.k !== 'tools' && el.dataset.k !== 'command') shown++;
  }
  count.textContent = term || mine.checked ? `${shown} match${shown===1?'':'es'}` : `${shown} messages`;
}
q.addEventListener('input', apply); mine.addEventListener('change', apply); tools.addEventListener('change', apply);
document.addEventListener('keydown', e => { if (e.key === '/' && document.activeElement !== q) { e.preventDefault(); q.focus(); } });
apply();
location.hash && document.querySelector(location.hash)?.scrollIntoView();
</script></body></html>"""


def render(path, open_it=True):
    items, title = parse(path)
    sid = os.path.basename(path)[:-6]
    title = title or "Claude session"
    where = where_map().get(sid, "")
    times = [i["t"] for i in items if i.get("t")]
    span = ""
    if times:
        f = lambda s: datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone().strftime("%b %d, %H:%M")
        span = f"{f(min(times))} → {f(max(times))}"
    you = sum(1 for i in items if i["k"] == "user")
    comp = sum(1 for i in items if i["k"] == "compact")
    meta = " · ".join(x for x in [
        html.escape(where), span, f"{you} messages from you",
        f"compacted {comp}×" if comp else "never compacted",
        f"resume: <code>claude --resume {html.escape(sid)}</code>"] if x)
    # The conversation is untrusted text inside a <script> block: escape every
    # character that could end the block or start markup, not just "</".
    data = json.dumps(items, ensure_ascii=False)
    for ch, esc in (("<", "\\u003c"), (">", "\\u003e"), ("&", "\\u0026"),
                    ("\u2028", "\\u2028"), ("\u2029", "\\u2029")):
        data = data.replace(ch, esc)
    # Fill all three slots in one pass, so text that happens to contain a slot
    # name (a session titled "__DATA__", say) is never substituted again.
    slots = {"__TITLE__": html.escape(title), "__META__": meta, "__DATA__": data}
    page = re.sub(r"__(?:TITLE|META|DATA)__", lambda m: slots[m.group(0)], PAGE)
    # A half emoji cut off in a transcript can't be written as UTF-8; show "?".
    page = page.encode("utf-8", "replace").decode("utf-8")
    os.makedirs(OUT, exist_ok=True)
    out = os.path.join(OUT, f"{sid}.html")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(page)
    print(out)
    if open_it:
        subprocess.run(["open", out])


def list_sessions(n):
    wm = where_map()
    for f in all_sessions()[:n]:
        sid = os.path.basename(f)[:-6]
        when = datetime.fromtimestamp(os.path.getmtime(f)).strftime("%b %d %H:%M")
        tag = f"  [{wm[sid].split(' · ')[0]}]" if sid in wm else ""
        print(f"{sid[:8]}  {when}  {title_of(f)[:70]}{tag}")


def search(term):
    wm, low = where_map(), term.lower()
    # Quick file filter. The files hold JSON, where " is stored as \" and so
    # on, so look for the escaped spellings of the phrase as well.
    pats = []
    for v in (term, json.dumps(term, ensure_ascii=False)[1:-1], json.dumps(term)[1:-1]):
        if v not in pats[1::2]:
            pats += ["-e", v]
    for f in all_sessions():
        r = subprocess.run(["grep", "-i", "-c", "-F"] + pats + ["--", f], capture_output=True, text=True)
        if not r.stdout.strip() or r.stdout.strip() == "0":
            continue
        items, title = parse(f)
        hits = [i for i in items if i["k"] in ("user", "claude", "compact")
                and low in (i.get("text") or i.get("summary") or "").lower()]
        if not hits:
            continue
        sid = os.path.basename(f)[:-6]
        tag = f" [{wm[sid].split(' · ')[0]}]" if sid in wm else ""
        print(f"\n{sid[:8]}  {title or '(untitled)'}{tag}  — {len(hits)} message(s)")
        for h in hits[:3]:
            txt = (h.get("text") or h.get("summary") or "").replace("\n", " ")
            i = txt.lower().find(low)
            snip = txt[max(0, i - 60): i + len(term) + 60]
            who = {"user": "you", "claude": "Claude", "compact": "summary"}[h["k"]]
            print(f"   {h['t'][:10]} {who}: …{snip}…")


def main():
    sys.stdout.reconfigure(errors="replace")
    args = sys.argv[1:]
    open_it = "--no-open" not in args
    args = [a for a in args if a != "--no-open"]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip()); return
    if args and args[0] in ("-l", "--list"):
        list_sessions(int(args[1]) if len(args) > 1 else 20); return
    if args and args[0] in ("-s", "--search"):
        if len(args) < 2:
            sys.exit("usage: claude-history -s TEXT")
        search(" ".join(args[1:])); return
    if args:
        render(find_session(args[0]), open_it); return
    t = os.environ.get("HC_TERMINAL_ID")
    if t and os.path.exists(os.path.join(RECORDS, t + ".json")):
        render(find_session(t), open_it); return
    print("Not in a recorded Herdr terminal. Recent sessions:\n")
    list_sessions(20)
    print("\nOpen one with: claude-history <id>")


if __name__ == "__main__":
    main()
