#!/usr/bin/python3 -I
"""claude-history: read a Claude Code session's full back-and-forth, including
everything from before compaction, as a searchable page in your browser.

  claude-history              this terminal's session (inside Herdr), else the list
  claude-history t6           the session recorded for Herdr terminal t6
  claude-history 7898ffa8     a session by id (or id prefix)
  claude-history -l [N]       list the N most recent sessions (default 20)
  claude-history -s TEXT      find sessions where TEXT was said (you or Claude)
  claude-history --no-open    write the page but don't open it

Pages are written to ~/.local/state/claude-history/ (rebuilt on each run).
From inside a Claude session, type:  ! claude-history
"""
import glob, html, json, os, re, subprocess, sys
from datetime import datetime

HOME = os.path.expanduser("~")
PROJECTS = os.path.join(HOME, ".claude", "projects")
STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state")
RECORDS = os.path.join(STATE, "claude-resume")
OUT = os.path.join(STATE, "claude-history")

SKIP_USER_PREFIXES = ("<task-notification>", "Base directory for this skill",
                      "Caveat: The messages below", "[Request interrupted")
REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
CMD_NAME = re.compile(r"<command-name>(.*?)</command-name>", re.S)
CMD_ARGS = re.compile(r"<command-args>(.*?)</command-args>", re.S)
# Turns that Claude Code or Herdr write on your behalf start with one of these
# tags. Newer transcripts also say who wrote each turn ("origin"); turns from
# the kinds below are left out. A message of yours that merely starts with some
# other tag (pasted HTML, <example_input>...) is kept.
MACHINE_ORIGINS = {"task-notification", "peer", "auto-continuation"}
MACHINE_TAGS = {
    "task-notification", "system-notification", "cross-session-message",
    "agent-message", "teammate-message", "hc",
    "local-command-caveat", "local-command-stdout", "local-command-stderr",
    "command-name", "command-message", "command-args", "command-contents",
    "bash-input", "bash-stdout", "bash-stderr", "user-prompt-submit-hook",
}


def origin_kind(o):
    k = o.get("kind") if isinstance(o, dict) else o
    return k if isinstance(k, str) else None


def all_sessions():
    files = [f for f in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl"))
             if "observer-sessions" not in f]
    return sorted(files, key=os.path.getmtime, reverse=True)


def find_session(arg):
    if re.fullmatch(r"t\w+", arg):
        rec = os.path.join(RECORDS, arg + ".json")
        if not os.path.exists(rec):
            sys.exit(f"No session recorded for terminal {arg}. Try: claude-history -l")
        arg = json.load(open(rec))["session_id"]
    hits = [f for f in all_sessions() if os.path.basename(f).startswith(arg)]
    if not hits:
        sys.exit(f"No session file matches {arg!r}. Try: claude-history -l")
    return hits[0]


def title_of(path):
    """Cheap title: last ai-title / custom-title line, else first prompt."""
    title, first = None, None
    try:
        out = subprocess.run(["grep", "-E", '"type":"(custom-title|ai-title)"', path],
                             capture_output=True, text=True).stdout.strip().splitlines()
        for line in out:
            d = json.loads(line)
            title = d.get("customTitle") or d.get("aiTitle") or title
    except Exception:
        pass
    if not title:
        with open(path, errors="replace") as fh:
            for line in fh:
                if '"type":"user"' in line:
                    d = json.loads(line)
                    c = d.get("message", {}).get("content")
                    if isinstance(c, str) and not c.startswith("<"):
                        first = c.strip().splitlines()[0][:80]
                        break
    return title or first or "(untitled)"


def where_map():
    m = {}
    for rec in glob.glob(os.path.join(RECORDS, "*.json")):
        try:
            d = json.load(open(rec))
            m[d["session_id"]] = f'{d["terminal"]} · {d.get("where") or ""}'
        except Exception:
            pass
    return m


def clean_user_text(c, origin=None):
    if origin_kind(origin) in MACHINE_ORIGINS:
        return None
    c = REMINDER.sub("", c).strip()
    m = CMD_NAME.search(c)
    if m and c.startswith("<command-"):
        a = CMD_ARGS.search(c)
        return ("command", (m.group(1) + " " + (a.group(1) if a else "")).strip())
    b = re.match(r"<bash-input>(.*?)</bash-input>", c, re.S)
    if b:
        return ("command", "! " + b.group(1).strip())
    # Machine-generated turns (task/agent notifications, hc notes, command
    # output) start with a known tag; real messages from you don't.
    tag = re.match(r"<([a-z][a-z_-]*)[ >]", c)
    if tag and tag.group(1) in MACHINE_TAGS:
        return None
    # Show pasted blocks as plain quoted text, without the wrapper tags.
    c = re.sub(r"</?pasted[_a-z-]*[^>]*>", "\n", c).strip()
    if not c or c.startswith(SKIP_USER_PREFIXES):
        return None
    return ("user", c)


def parse(path):
    items, title, custom = [], None, None
    pending_tools = []

    def flush_tools():
        if pending_tools:
            items.append({"k": "tools", "t": pending_tools[0][1], "names": [n for n, _ in pending_tools]})
            pending_tools.clear()

    with open(path, errors="replace") as fh:
        for line in fh:
            # Fast reject of the bulky entry types before JSON parsing.
            if line.startswith('{"type":"api-request') or '"type":"file-history' in line[:60]:
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            t, ts = d.get("type"), d.get("timestamp", "")
            if t == "ai-title":
                title = d.get("aiTitle") or title
            elif t == "custom-title":
                custom = d.get("customTitle") or custom
            if d.get("isSidechain"):
                continue
            if t == "system" and d.get("subtype") == "compact_boundary":
                flush_tools()
                cm = d.get("compactMetadata") or {}
                items.append({"k": "compact", "t": ts, "trigger": cm.get("trigger", ""), "summary": ""})
                continue
            if t == "attachment":
                a = d.get("attachment") or {}
                if a.get("type") == "queued_command" and a.get("prompt"):
                    p = a["prompt"]
                    if isinstance(p, list):
                        n_img = sum(1 for b in p if isinstance(b, dict) and b.get("type") == "image")
                        p = "\n".join(b.get("text", "") for b in p if isinstance(b, dict) and b.get("type") == "text")
                        if n_img:
                            p += f"\n\n[{n_img} image(s) attached]"
                    r = clean_user_text(str(p), a.get("origin"))
                    if r and r[0] == "user":
                        flush_tools()
                        items.append({"k": "user", "t": a.get("timestamp", ts), "text": r[1], "mid": True})
                continue
            msg = d.get("message") or {}
            content = msg.get("content")
            if t == "user":
                if d.get("isCompactSummary"):
                    text = content if isinstance(content, str) else " ".join(
                        b.get("text", "") for b in content if isinstance(b, dict))
                    for it in reversed(items):
                        if it["k"] == "compact":
                            it["summary"] = text
                            break
                    else:
                        items.append({"k": "compact", "t": ts, "trigger": "", "summary": text})
                    continue
                if d.get("isMeta"):
                    continue
                if isinstance(content, str):
                    r = clean_user_text(content, d.get("origin"))
                    if r:
                        flush_tools()
                        k, text = r
                        items.append({"k": k, "t": ts, "text": text})
                elif isinstance(content, list):
                    if any(b.get("type") == "tool_result" for b in content if isinstance(b, dict)):
                        continue
                    texts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
                    imgs = sum(1 for b in content if isinstance(b, dict) and b.get("type") == "image")
                    r = clean_user_text("\n".join(texts), d.get("origin")) if texts else None
                    if r or imgs:
                        flush_tools()
                        text = (r[1] if r else "") + ("\n\n" + f"[{imgs} image(s) attached]" if imgs else "")
                        items.append({"k": "user", "t": ts, "text": text.strip()})
            elif t == "assistant" and isinstance(content, list):
                for b in content:
                    if not isinstance(b, dict):
                        continue
                    if b.get("type") == "text" and b.get("text", "").strip():
                        flush_tools()
                        items.append({"k": "claude", "t": ts, "text": b["text"].strip()})
                    elif b.get("type") in ("tool_use", "server_tool_use"):
                        name = b.get("name", "tool")
                        name = re.sub(r"^mcp__(claude_ai_|plugin_[^_]+_)?", "", name).replace("__", ": ")
                        pending_tools.append((name, ts))
    flush_tools()
    return items, custom or title


PAGE = r"""<!doctype html>
